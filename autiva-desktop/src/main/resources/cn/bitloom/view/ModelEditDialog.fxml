<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.bitloom.controller.ModelEditDialogController"
      styleClass="model-edit-dialog"
      spacing="14"
      prefWidth="440"
      stylesheets="@../style/settings-page.css">
    <VBox spacing="6">
        <Label text="名称" styleClass="settings-page__row-title"/>
        <TextField fx:id="nameField" styleClass="settings-page__path-field" promptText="如 DeepSeek / GLM-4.6"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Base URL" styleClass="settings-page__row-title"/>
        <TextField fx:id="baseUrlField" styleClass="settings-page__path-field" promptText="https://api.deepseek.com"/>
    </VBox>
    <VBox spacing="6">
        <Label text="API Key" styleClass="settings-page__row-title"/>
        <PasswordField fx:id="apiKeyField" styleClass="settings-page__path-field" promptText="sk-..."/>
    </VBox>
    <VBox spacing="6">
        <Label text="模型名称" styleClass="settings-page__row-title"/>
        <TextField fx:id="chatModelField" styleClass="settings-page__path-field" promptText="deepseek-chat"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Completions Path" styleClass="settings-page__row-title"/>
        <TextField fx:id="completionsPathField" styleClass="settings-page__path-field" promptText="/v1/chat/completions"/>
    </VBox>
    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="model-edit-dialog__actions">
        <Button text="取消" styleClass="settings-page__secondary-btn" onAction="#onCancel"/>
        <Button text="保存" styleClass="settings-page__login-btn" onAction="#onConfirm"/>
    </HBox>
</VBox>
