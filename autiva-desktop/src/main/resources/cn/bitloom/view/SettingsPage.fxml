<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox fx:id="settingsPage" styleClass="settings-page" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="cn.bitloom.controller.SettingsPageController"
      alignment="TOP_CENTER"
      stylesheets="@../style/button-bar.css,@../style/settings-page.css"
      prefWidth="720" prefHeight="600"
>
    <HBox styleClass="button-bar" VBox.vgrow="NEVER">
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="dynamic-btn" text="保存" onAction="#onSave"/>
        <Button styleClass="dynamic-btn" text="重置" onAction="#onReset"/>
    </HBox>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                styleClass="settings-page__scroll-pane" prefWidth="600" maxWidth="700">
        <VBox styleClass="settings-page__content">

            <VBox>
                <Label text="微信配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox fx:id="weixinQrRow" styleClass="settings-page__row" alignment="CENTER">
                        <StackPane styleClass="settings-page__qr-stack">
                            <ImageView fx:id="weixinQrImageView" styleClass="settings-page__qr-image"/>
                            <VBox fx:id="weixinConnectedOverlay" styleClass="settings-page__qr-overlay" alignment="CENTER" visible="false">
                                <Button fx:id="weixinRebindButton" text="重新加载" styleClass="settings-page__rebind-btn"/>
                            </VBox>
                            <VBox fx:id="weixinExpiredOverlay" styleClass="settings-page__qr-overlay" alignment="CENTER" visible="false">
                                <Button fx:id="weixinRefreshButton" text="重新加载" styleClass="settings-page__rebind-btn"/>
                            </VBox>
                        </StackPane>
                        <Label fx:id="weixinQrHintLabel" text="扫码即可绑定微信" styleClass="settings-page__qr-hint" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="搜索配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="博查 API Key" styleClass="settings-page__row-title"/>
                        <PasswordField fx:id="bochaApiKeyField" styleClass="settings-page__path-field"
                                       promptText="博查搜索 API Key"/>
                        <Label text="博查搜索平台的 API Key，用于 WebSearch 工具" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <HBox styleClass="settings-page__section-head" alignment="CENTER_LEFT">
                    <Label text="模型配置" styleClass="settings-page__section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addModelButton" text="添加模型" styleClass="settings-page__secondary-btn"
                            onAction="#onAddModel"/>
                </HBox>
                <VBox fx:id="modelListContainer" styleClass="settings-page__card"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" styleClass="settings-page__spacer"/>

        </VBox>
    </ScrollPane>
</VBox>
